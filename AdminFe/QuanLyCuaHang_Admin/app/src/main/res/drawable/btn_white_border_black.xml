<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Nền xanh nhạt -->
    <solid android:color="#E3EFFB" />

    <!-- Viền đen -->
    <stroke
        android:width="2dp"
        android:color="#000000" />

    <!-- Bo góc -->
    <corners android:radius="8dp" />

    <!-- Padding bên trong -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />
</shape>
