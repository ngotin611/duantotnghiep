<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="5dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Mã đơn + loại -->
        <TextView
            android:id="@+id/txtOrderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#001 - Tại bàn 1"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@android:color/black" />

        <!-- Số món -->
        <TextView
            android:id="@+id/txtOrderAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 món"
            android:textSize="13sp"
            android:textColor="#4A4A4A"
            android:layout_marginTop="3dp" />

        <!-- Tổng tiền -->
        <TextView
            android:id="@+id/txtOrderMoney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150.000 đ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/chudao"
            android:layout_marginTop="6dp" />

        <!-- Thời gian tạo -->
        <TextView
            android:id="@+id/txtOrderTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã tạo: 20 phút trước"
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp" />

        <!-- Trạng thái -->
        <TextView
            android:id="@+id/txtOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa thanh toán"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/chudao"
            android:layout_marginTop="4dp" />

        <!-- Hàng nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnPay"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Tất toán"
                android:textSize="12sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"

                android:backgroundTint="#007AFF"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Hủy"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:paddingLeft="12dp"
                android:backgroundTint="#007AFF"
                android:paddingRight="12dp"
                android:textColor="@android:color/white"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
