<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Icon thông báo -->
    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_notification_order"
        android:background="@drawable/notification_icon_bg"
        android:padding="12dp"
        android:layout_marginEnd="16dp" />

    <!-- Nội dung thông báo -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đơn hàng #12345 đã được xác nhận"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/notification_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đơn hàng của bạn đã được xác nhận và đang được chuẩn bị. Dự kiến giao hàng trong 30 phút."
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/notification_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 giờ trước"
            android:textColor="#999999"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Nút đánh dấu đã đọc -->
    <ImageView
        android:id="@+id/btn_mark_read"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_mark_read"
        android:backgroundTint="#7D4B1D"
        android:padding="4dp"
        android:layout_marginStart="8dp" />

    <!-- Badge thông báo mới -->
    <View
        android:id="@+id/notification_badge"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/notification_badge"
        android:layout_marginStart="8dp"
        android:layout_gravity="center_vertical" />

</LinearLayout>